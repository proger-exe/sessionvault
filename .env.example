# --- Telegram-бот ---------------------------------------------------------
# Получить у @BotFather. Бот должен быть в приватном режиме (никаких групп).
BOT_TOKEN=

# Telegram user ID единственного Owner (число, не username). Узнать через
# @userinfobot или из /start у любого бота.
OWNER_ID=

# --- Telegram MTProto (Kurigram) ------------------------------------------
# Получить на https://my.telegram.org/apps
PYROGRAM_API_ID=
PYROGRAM_API_HASH=

# --- Шифрование секретов --------------------------------------------------
# 32-байтовый мастер-ключ, base64 без переносов.
# Сгенерировать: `python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"`
MASTER_KEY=
# Опционально при ротации — новый ключ; воркеры лениво перешифруют DEK-и.
# MASTER_KEY_V2=

# --- Хранилища ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tg:tg@localhost:5432/sessionvault
REDIS_URL=redis://localhost:6379/0

# --- Логика приложения ----------------------------------------------------
# Экспериментальный tdata за feature flag.
EXPORTS_TDATA_ENABLED=false

# Где export-worker временно держит уже зашифрованные архивы до отправки ботом.
EXPORT_TMP_DIR=/tmp/sessionvault-exports
EXPORT_ARCHIVE_TTL_SECONDS=300

# Таймауты login-flow, сек.
LOGIN_FLOW_TTL_SECONDS=300

# Уровень логов: DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL=INFO
