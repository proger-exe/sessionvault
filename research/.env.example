# Telegram API credentials — get from https://my.telegram.org/apps
# ЛЮБОЙ реальный .env НЕ коммитим.
# Совместимо с любым Pyrogram-форком (namespace `pyrogram`), в т.ч. Kurigram.
PYROGRAM_API_ID=
PYROGRAM_API_HASH=

# Тестовый номер владельца в формате E.164
TEST_PHONE=+70000000000

# Каталог для research-артефактов (auth key, sessions, tdata). НЕ коммитить.
RESEARCH_STATE_DIR=./_state

# TDesktop-runner (Этап 0.4):
# Фиксированная версия TDesktop, которую тестируем.
TDESKTOP_VERSION=5.7.2
